# Rename this file to .env and fill in your own values
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sourabh-portfolio
CLIENT_ORIGIN=http://localhost:5173

# Used once by `npm run seed` to create your admin login in MongoDB.
ADMIN_USERNAME=sourabh
ADMIN_PASSWORD=change-this-password

# Secret used to sign admin login tokens - make this a long random string
JWT_SECRET=replace-with-a-long-random-string

# --- Contact form -> email delivery ---
# Works with Gmail (create an "App Password", not your normal password:
# https://myaccount.google.com/apppasswords) or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_RECEIVER_EMAIL=sourabhnagarkar26@gmail.com

# --- GitHub auto-sync ---
# Your GitHub username - new public repos get pulled in as projects
GITHUB_USERNAME=sourabhnagarkar
# Cron schedule for automatic sync (default: once a day at 3am). Leave blank to disable.
GITHUB_SYNC_CRON=0 3 * * *
